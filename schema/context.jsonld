{
  "@context": {
    "@version": 1.1,

    "lasso": "https://nikilachniki.github.io/lassoDBData/ns#",
    "entry": "https://nikilachniki.github.io/lassoDBData/id/entry/",
    "work": "https://nikilachniki.github.io/lassoDBData/id/work/",
    "print": "https://nikilachniki.github.io/lassoDBData/id/print/",
    "person": "https://nikilachniki.github.io/lassoDBData/id/person/",
    "manuscript": "https://nikilachniki.github.io/lassoDBData/id/manuscript/",
    "expression": "https://nikilachniki.github.io/lassoDBData/id/expression/",

    "dcterms": "http://purl.org/dc/terms/",
    "frbr": "http://purl.org/vocab/frbr/core#",
    "bibo": "http://purl.org/ontology/bibo/",
    "schema": "https://schema.org/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "items": "@graph",

    "CatalogueEntry": "lasso:CatalogueEntry",
    "Work": "frbr:Work",
    "Print": "frbr:Manifestation",
    "Person": "schema:Person",
    "ManuscriptWitness": "lasso:ManuscriptWitness",
    "Expression": "frbr:Expression",

    "lv": "lasso:lv",
    "lvBase": { "@id": "lasso:lvBase", "@type": "xsd:integer" },
    "lvPart": { "@id": "lasso:lvPart", "@type": "xsd:integer" },
    "lvVariant": "lasso:lvVariant",
    "lvAnh": { "@id": "lasso:lvAnh", "@type": "xsd:integer" },

    "title": "dcterms:title",
    "titles": { "@id": "dcterms:title", "@container": "@set" },
    "preferredTitle": "lasso:preferredTitle",
    "preferredTitleBasis": "lasso:preferredTitleBasis",
    "normalizedTitle": "lasso:normalizedTitle",
    "normalizedTitleBasis": "lasso:normalizedTitleBasis",
    "variantTitles": { "@id": "dcterms:alternative", "@container": "@set" },

    "voices": { "@id": "lasso:voices", "@type": "xsd:integer" },
    "voicesRaw": "lasso:voicesRaw",
    "voiceCounts": { "@id": "lasso:voices", "@type": "xsd:integer", "@container": "@set" },

    "firstPrint": "lasso:firstPrintSiglum",
    "firstPrintYear": { "@id": "lasso:firstPrintYear", "@type": "xsd:gYear" },
    "firstPrintNo": { "@id": "lasso:firstPrintNo", "@type": "xsd:integer" },
    "prints": { "@id": "lasso:firstPrintSiglum", "@container": "@set" },
    "siglum": "lasso:siglum",
    "year": { "@id": "dcterms:date", "@type": "xsd:gYear" },
    "rism": { "@id": "rdfs:seeAlso", "@type": "@id" },
    "part": "lasso:printPart",
    "dateApproximate": { "@id": "lasso:dateApproximate", "@type": "xsd:boolean" },
    "printAppearances": { "@id": "lasso:printAppearance", "@container": "@set" },
    "inPrint": { "@id": "lasso:inPrint", "@type": "@id" },
    "piece": "lasso:pieceInPrint",
    "description": "dcterms:description",
    "references": { "@id": "dcterms:bibliographicCitation", "@type": "@json" },
    "partbooks": "lasso:partbooks",
    "shortTitle": "bibo:shortTitle",

    "textAuthor": "lasso:textAuthorRaw",
    "textAuthorPerson": { "@id": "schema:lyricist", "@type": "@id" },
    "textAuthorUncertain": { "@id": "lasso:textAuthorUncertain", "@type": "xsd:boolean" },
    "textAuthors": { "@id": "schema:lyricist", "@type": "@id", "@container": "@set" },
    "uncertainTextAuthors": { "@id": "lasso:uncertainTextAuthor", "@type": "@id", "@container": "@set" },
    "textSource": "lasso:textSource",
    "textSources": { "@id": "lasso:textSource", "@container": "@set" },
    "preferredName": "schema:name",
    "variantNames": { "@id": "schema:alternateName", "@container": "@set" },
    "gnd": { "@id": "schema:sameAs", "@type": "@id" },
    "viaf": { "@id": "schema:sameAs", "@type": "@id" },

    "completeEdition": "lasso:completeEdition",
    "completeEditions": { "@id": "lasso:completeEdition", "@container": "@set" },

    "genre": "schema:genre",
    "genres": { "@id": "schema:genre", "@container": "@set" },
    "language": "dcterms:language",
    "languages": { "@id": "dcterms:language", "@container": "@set" },

    "note": "rdfs:comment",
    "entries": { "@id": "lasso:hasEntry", "@type": "@id", "@container": "@set" },
    "entryCount": { "@id": "lasso:entryCount", "@type": "xsd:integer" },
    "manuscripts": { "@id": "lasso:hasManuscriptWitness", "@type": "@id", "@container": "@set" },
    "expressions": { "@id": "frbr:realization", "@type": "@id", "@container": "@set" },
    "realizationOf": { "@id": "frbr:realizationOf", "@type": "@id" },
    "isPartOf": { "@id": "dcterms:isPartOf", "@type": "@id" },
    "hasPart": { "@id": "dcterms:hasPart", "@type": "@id", "@container": "@set" },
    "pars": "lasso:pars",

    "rismSiglum": "lasso:rismSiglum",
    "place": "lasso:place",
    "library": "lasso:library",
    "shelfmark": "lasso:shelfmark",
    "shelfmarkAlt": "lasso:shelfmarkAlt",
    "sourceType": "lasso:sourceType",
    "dating": "dcterms:date",
    "link": { "@id": "rdfs:seeAlso", "@type": "@id" },
    "provenance": "dcterms:provenance",
    "sourceNote": "lasso:sourceNote",
    "literature": "dcterms:isReferencedBy",

    "extra": "lasso:extra"
  }
}
